# ─────────────────────────────────────────────────────────────────────────────
# Messora configuration. Copy to .env:   cp .env.example .env
#
# Every secret below may be left EMPTY: on first start `messora-init`
# generates strong random values and stores them in the `messora-secrets`
# Docker volume. Set a value here only if you need to choose it yourself.
# Never commit your .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
# production | development | test
APP_ENV=production
# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=json
# Image tag for locally built images.
MESSORA_VERSION=dev

# ── Public address ───────────────────────────────────────────────────────────
# The URL users open in the browser, including the port if not 80/443.
# Used for realtime (WebSocket) origin checks and links in e-mails.
PUBLIC_APP_URL=http://localhost
# What Caddy listens for. ":80" = plain HTTP on any host name (local use).
# Set your domain (e.g. messora.example.com) to get automatic HTTPS —
# WhatsApp webhooks require HTTPS. DNS must point to this server.
SITE_ADDRESS=:80
# Host ports published by Caddy.
HTTP_PORT=80
HTTPS_PORT=443

# ── Secrets (leave empty to auto-generate) ───────────────────────────────────
# 32 random bytes, standard base64 (openssl rand -base64 32). Encrypts the
# WhatsApp access token and other credentials at rest. BACK IT UP: if lost,
# stored credentials cannot be decrypted.
APP_ENCRYPTION_KEY=
# Shared secret between the panel (Next.js BFF) and the API, ≥ 32 chars.
BFF_SHARED_SECRET=
# Only read when the database volume is first created; changing it later
# requires ALTER ROLE inside PostgreSQL.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
CENTRIFUGO_API_KEY=
CENTRIFUGO_HMAC_SECRET=
# Token you enter in the Meta App dashboard when subscribing the webhook.
META_VERIFY_TOKEN=

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=messora
POSTGRES_DB=messora
# Alternatively give a full DSN for an external database (overrides the above):
# DATABASE_URL=postgres://user:pass@host:5432/messora?sslmode=require
DB_MAX_CONNS=20

# ── Redis ────────────────────────────────────────────────────────────────────
# Alternatively an external Redis (must use maxmemory-policy noeviction):
# REDIS_URL=redis://:password@host:6379/0

# ── Worker ───────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=20
# queue=priority pairs; higher priority is served more often.
WORKER_QUEUES=critical=6,campaigns=3,default=3,ai=2,bulk=1
# Share of each number's throughput campaigns leave for inbox, API and
# automation messages (percent, 5–90).
CAMPAIGN_RESERVED_PERCENT=20
# Grace period for in-flight jobs on shutdown (keep below the worker's
# stop_grace_period in docker-compose.yml).
SHUTDOWN_TIMEOUT=30s

# ── Workspace settings (optional) ───────────────────────────────────────────
# Normally chosen in the setup wizard and Settings. A value set here wins and
# is shown as locked in the panel.
# APP_ORGANIZATION_NAME=Acme
# APP_DEFAULT_LOCALE=tr                # en | tr
# APP_DEFAULT_TIMEZONE=Europe/Istanbul
# APP_DATE_FORMAT=dd.MM.yyyy           # dd.MM.yyyy | dd/MM/yyyy | MM/dd/yyyy | yyyy-MM-dd | d MMM yyyy
# APP_TIME_FORMAT=24h                  # 24h | 12h
# APP_MFA_REQUIRED_ROLES=owner,admin   # comma list, or "none"

# ── E-mail (password reset and invitations) ─────────────────────────────────
# Usually configured in Settings → E-mail (password stored encrypted). Setting
# SMTP_HOST here takes over and locks the panel. Without any SMTP server,
# invitation links are shown in the panel and password reset is unavailable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Messora <no-reply@example.com>
# starttls (587) | tls (465) | none (local test servers only)
SMTP_TLS=starttls

# ── Meta WhatsApp Cloud API (optional: accounts can be connected in the panel) ─
# When META_WABA_ID and META_ACCESS_TOKEN are set, that account is connected
# on first start. Webhook callback URL: <PUBLIC_APP_URL>/webhooks/whatsapp
META_APP_ID=
# The app secret signs Meta's webhooks; webhooks are rejected until it is set
# here or on the account in the panel.
META_APP_SECRET=
# Graph API version; v26.0 is the newest as of 2026-11 (Meta's versions table).
META_GRAPH_API_VERSION=v26.0
META_ACCESS_TOKEN=
META_WABA_ID=
# Refuse every request to Meta (always on when APP_ENV=test).
META_DRY_RUN=false

# ── AI (optional) ────────────────────────────────────────────────────────────
# AI providers and their API keys are set up in the panel (Settings → AI).
# A scriptable fake provider for tests and development; refused with
# APP_ENV=production.
AI_FAKE_PROVIDER=false

# ── Resource limits (optional) ───────────────────────────────────────────────
# Memory per container; defaults suit a small server (see docs/OPERATIONS.md).
# MEM_POSTGRES=1g
# MEM_REDIS=512m
# MEM_MESSORA_API=512m
# MEM_MESSORA_WORKER=512m
# MEM_MESSORA_WEB=512m

# ── Tracing (optional) ───────────────────────────────────────────────────────
# OpenTelemetry over OTLP/HTTP; off when empty. See docs/OPERATIONS.md.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1

# ── Behind an existing reverse proxy (Traefik, Dokploy, Coolify …) ─────────
# Start with: docker compose -f docker-compose.yml -f docker-compose.proxy.yml up -d
# Caddy then opens no host ports and the proxy routes PUBLIC_HOST to it.
# PUBLIC_HOST=messora.example.com
# PROXY_NETWORK=dokploy-network
# PROXY_ENTRYPOINT=websecure
# PROXY_CERTRESOLVER=letsencrypt
# PROXY_ROUTER=messora            # unique per installation on one proxy
