---
import V from '../../views/Article.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
  const all = await getCollection('blog', (e) => e.data.lang === 'tr');
  return all.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props as any;
---
<V lang="tr" entry={entry} kind="blog" />
