---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Mock from '../components/Mock.astro';
import HeroVisual from '../components/HeroVisual.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqList from '../components/FaqList.astro';
import type { Lang, Faq } from '../data/types';
import { meta } from '../data/meta';
import { appUrls } from '../data/routes';
import { plans, P } from '../lib/plans';
import { t } from '../i18n/ui';
import { features, solutions, fPath, sPath, r, readingMinutes } from '../lib/site';
import { faqLd } from '../lib/schema';
import { getCollection } from 'astro:content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = lang === 'tr';
const T = (a: string, b: string) => (tr ? a : b);
const u = t(lang);
const m = meta.home[lang];
const fs = features(lang);
const f = (k: string) => fs.find((x) => x.key === k)!;
const posts = (await getCollection('blog', (e) => e.data.lang === lang)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const blogBase = tr ? '/blog/' : '/en/blog/';
const ph = P.phrases(plans, lang);

const rows = [
  { k: 'inbox', mock: 'team', eyebrow: T('Ekip gelen kutusu', 'Team inbox'),
    h: T('Her konuşmanın bir sahibi olsun.', 'Every conversation has an owner.'),
    p: T('Tüm WhatsApp numaralarınızın mesajları tek gelen kutusunda. Konuşmayı birine atayın, ekibe not bırakın, gerektiğinde devredin. Kimin ilgilendiği, müşterinin izin durumu ve 24 saatlik pencerenin ne zaman kapanacağı hep görünür.',
      'Messages from all your WhatsApp numbers in one inbox. Assign a conversation, leave a note for the team, hand it over when needed. Who is on it, the customer’s consent and when the 24-hour window closes are always visible.'),
    pts: [T('Atama, sahiplik ve devir geçmişi', 'Assignment, ownership and handover history'), T('Ekibe özel notlar', 'Internal notes for the team'), T('Owner, Admin, Manager ve Agent rolleri', 'Owner, Admin, Manager and Agent roles')] },
  { k: 'campaigns', mock: 'campaigns', eyebrow: T('Kampanyalar', 'Campaigns'),
    h: T('Göndermeden önce kime, ne kadara ve ne zaman bitecek, bilin.', 'Know who, how much and when it ends — before you send.'),
    p: T('Kitleyi segment, grup ya da etiketle seçin. Mesaj almak istemeyenler otomatik çıkarılır ve size kaç kişi olduğu söylenir. Meta’nın ülke ve kategori bazlı ücreti, tahmini bitiş saati ve aynı numarada süren diğer kampanyalarla adil paylaşım gönderimden önce ekranda.',
      'Pick the audience by segment, group or tag. People who don’t want messages are left out automatically, and you are told how many. Meta’s fee by country and category, the estimated finish and fair sharing with other campaigns on the same number are on screen before you send.'),
    pts: [T('İzin ve ret kategoriye göre kayıtlı; DUR yazan çıkar', 'Consent per category; replying STOP opts out'), T('Duraklat, devam et, iptal et', 'Pause, resume, cancel'), T('Kalite uyarısında kampanya kendiliğinden durur', 'Stops by itself on a quality warning')] },
  { k: 'ai', mock: 'ai', eyebrow: T('Yapay zekâ ajanları', 'AI agents'), ai: true,
    h: T('Sen bakarken AI cevapladı; emin olmadığında sana devretti.', 'The AI answered while you were busy — and handed over when it wasn’t sure.'),
    p: T('OpenAI, Anthropic veya Gemini ile çalışan ajanlar sık soruları yanıtlar, adı, e-postayı ve şehri konuşmadan çıkarıp kişi kartına yazar. Müşteri “temsilci” dediğinde ya da ajan emin olmadığında konuşma ekibe geçer.',
      'Agents powered by OpenAI, Anthropic or Gemini answer common questions and pull the name, e-mail and city from the chat into the contact card. When the customer asks for a person, or the agent isn’t sure, the conversation goes to your team.'),
    pts: [T('Her WhatsApp numarasına ayrı AI profili', 'A separate AI profile per WhatsApp number'), T('Konuşmalar model eğitiminde kullanılmaz', 'Conversations aren’t used to train models'), T('Kullanım aylık AI kredisiyle şeffaf', 'Usage is clear, in monthly AI credits')] },
  { k: 'automations', mock: 'automations', eyebrow: T('Otomasyonlar', 'Automations'),
    h: T('Tekrarlayan işi tuvale çizin, gerisini Messora yapsın.', 'Draw the repetitive work on a canvas and let Messora do it.'),
    p: T('Tetikleyiciyi seçin, adımları sürükleyip bağlayın, koşulla dallandırın. Karşılama, abonelikten çıkma, cevapsız müşteriyi takip, temsilciye devir gibi 11 hazır şablonla başlayın; her çalışmanın izlediği yolu tuvalde görün.',
      'Pick a trigger, drag and connect the steps, branch with conditions. Start from 11 ready presets such as welcome, unsubscribe, follow-up and hand-over, and see the path each run took on the canvas.'),
    pts: [T('Döngü ve çift tetiklenme koruması', 'Loop and duplicate protection'), T('Geri al / yinele, otomatik yerleşim', 'Undo / redo, automatic layout'), T('Hazır şablonlar her pakette', 'Presets in every plan')] },
] as const;

const ft = f('templates'), fa = f('analytics'), fapi = f('api');
const providers = [['Meta WhatsApp Cloud API', T('resmi API', 'official API')], ['OpenAI', T('AI ajanları', 'AI agents')], ['Anthropic', T('AI ajanları', 'AI agents')], ['Google Gemini', T('AI ajanları', 'AI agents')], ['AWS', 'eu-central-1 · Frankfurt'], ['PostgreSQL', T('satır bazlı güvenlik', 'row-level security')]];

const faqs: Faq[] = tr ? [
  { q: 'Messora resmi WhatsApp API’si mi kullanıyor?', a: 'Evet. Messora yalnızca Meta’nın resmi WhatsApp Business Cloud API’si ile çalışır. QR kodla bağlanan, WhatsApp Web’i taklit eden yöntemler kullanmayız; bu yüzden numaranız kapanma riskiyle karşılaşmaz ve şablonlarınız Meta onayından geçer.' },
  { q: 'Meta’nın mesaj ücretleri pakete dahil mi?', a: 'Hayır. Meta, iletilen her şablon mesajı için kategoriye ve ülkeye göre ayrıca ücret alır. Messora bu ücreti kampanyayı göndermeden önce gösterir. Ayrıntılar için [fiyatlar sayfasındaki Meta ücretleri bölümüne](/fiyatlar#meta-ucretleri) bakın.' },
  { q: 'Deneme süresinde neler açık?', a: 'Panelin tamamını 14 gün boyunca ücretsiz kullanırsınız; kart bilgisi istemeyiz. Süre bitince size uyan paketi seçip kaldığınız yerden devam edersiniz. Meta’nın mesaj ücretleri denemede de Meta tarafından ayrıca uygulanır.' },
  { q: 'Mevcut WhatsApp numaramı kullanabilir miyim?', a: 'Kullanabilirsiniz. Numara WhatsApp Business uygulamasında kayıtlıysa önce oradan kaldırılması ya da Meta’nın taşıma adımlarının izlenmesi gerekir. Kurulum sihirbazı ve [rehberimiz](/blog/whatsapp-business-api-nedir-nasil-basvurulur) adım adım anlatır.' },
  { q: 'Verilerimiz nerede tutuluyor?', a: 'AWS’nin Frankfurt (eu-central-1) bölgesinde, Avrupa Birliği’nde. Her firmanın verisi veritabanında satır bazlı güvenlikle ayrılır ve her gece şifreli yedek alınır. Ayrıntılar [güvenlik sayfasında](/guvenlik).' },
] : [
  { q: 'Does Messora use the official WhatsApp API?', a: 'Yes. Messora works only with Meta’s official WhatsApp Business Cloud API. We don’t use QR-code tools that imitate WhatsApp Web, so your number isn’t put at risk and your templates go through Meta’s approval.' },
  { q: 'Are Meta’s message fees included?', a: 'No. Meta charges for each delivered template message, by category and country. Messora shows that fee before you send a campaign. See the [Meta fees section of the pricing page](/en/pricing#meta-fees).' },
  { q: 'What is included in the trial?', a: 'You can use the whole panel free for 14 days, and we don’t ask for a card. When it ends, choose the plan that fits and carry on where you left off. Meta’s message fees still apply during the trial.' },
  { q: 'Can I use my existing WhatsApp number?', a: 'Yes. If the number is registered in the WhatsApp Business app, it has to be removed from there first or moved following Meta’s steps. The setup wizard and [our guide](/en/blog/what-is-whatsapp-business-api-how-to-apply) walk you through it.' },
  { q: 'Where is our data stored?', a: 'In AWS’s Frankfurt region (eu-central-1), in the European Union. Each company’s data is separated in the database with row-level security, and encrypted backups are taken every night. More on the [security page](/en/security).' },
];
---
<Base lang={lang} title={m.title} description={m.description} path={r(lang, 'home')} alt={{ tr: '/', en: '/en' }} jsonLd={[faqLd(faqs)]} plansLd="home">
  <section class="hero-home dark lit">
    <div class="wrap hh-copy">
      <p class="pill-eyebrow ld"><b>Meta</b>{m.eyebrow}</p>
      <h1 class="ld-h">{T('WhatsApp’ta satış, destek ve kampanya.', 'Sales, support and campaigns on WhatsApp.')} <span class="grad-text">{T('Tek panelde.', 'In one place.')}</span></h1>
      <p class="lead ld" style="--i:1">{T('Messora, ekibinizin WhatsApp konuşmalarını tek gelen kutusunda toplar, izin veren müşterilerinize kampanya gönderir ve yapay zekâyı ekibin yanında çalıştırır. Meta’nın ücretini göndermeden önce görürsünüz.',
        'Messora brings your team’s WhatsApp conversations into one inbox, sends campaigns to customers who said yes, and puts AI to work next to your team. You see Meta’s fee before you send.')}</p>
      <div class="actions ld" style="--i:2">
        <a class="btn btn-lg" href={appUrls.signup} data-signup>{u.trialLong}<Icon name="arrow-right" /></a>
        <a class="btn btn-ghost btn-lg" href={r(lang, 'demo')}>{u.demo}</a>
      </div>
      <ul class="hero-points ld" style="--i:3">
        <li><Icon name="check-circle" />{T('Meta’nın resmi Cloud API’si', 'Meta’s official Cloud API')}</li>
        <li><Icon name="check-circle" />{T('Veriler AB’de, Frankfurt’ta', 'Data in the EU, in Frankfurt')}</li>
        <li><Icon name="check-circle" />{T('Kart gerekmez', 'No card needed')}</li>
      </ul>
    </div>
    <div class="wrap hh-vis"><HeroVisual lang={lang} /></div>
  </section>

  <section class="after-hero">
    <div class="wrap">
      <p class="trust-label rv">{T('Üzerine kurulduğu altyapı', 'Built on')}</p>
      <div class="marquee rv">
        <div class="marquee-track">
          <ul aria-label={T('Messora’nın kullandığı altyapı', 'Infrastructure Messora uses')}>{providers.map(([n, d]) => <li>{n}<small>{d}</small></li>)}</ul>
          <ul aria-hidden="true">{providers.map(([n, d]) => <li>{n}<small>{d}</small></li>)}</ul>
        </div>
      </div>
      <div class="why">
        <div class="rv"><span class="ibox"><Icon name="shield" /></span><h2 class="h3">{T('Resmi API, kapanma korkusu yok', 'Official API, no ban roulette')}</h2><p>{T('Gönderimler Meta’nın onayladığı şablonlarla ve kalite kurallarına göre yapılır.', 'Messages go out with Meta-approved templates and within the quality rules.')}</p></div>
        <div class="rv"><span class="ibox"><Icon name="coin" /></span><h2 class="h3">{T('Ücret sürpriz değil', 'No surprise fees')}</h2><p>{T('Meta’nın ücreti, kampanyayı başlatmadan önce ülke ve kategoriye göre hesaplanır.', 'Meta’s fee is calculated by country and category before the campaign starts.')}</p></div>
        <div class="rv"><span class="ibox"><Icon name="check-circle" /></span><h2 class="h3">{T('İzin kayıt altında', 'Consent on record')}</h2><p>{T('Kim, ne zaman, hangi kategori için izin verdi ya da çıktı — geçmişiyle saklanır.', 'Who opted in or out, when and for which category — stored with its history.')}</p></div>
      </div>
    </div>
  </section>

  <section class="sec story" data-story>
    <div class="wrap">
      <div class="sec-head center">
        <p class="eyebrow rv">{T('Tek panel', 'One panel')}</p>
        <h2 class="rv-h">{T('Bir konuşmanın bütün yolculuğu, aynı ekranda.', 'A conversation’s whole journey, on one screen.')}</h2>
      </div>
      <div class="story-grid">
        <div class="story-steps">
          {rows.map((row) => (
            <article class="story-step" data-step>
              <p class:list={['eyebrow', { ai: 'ai' in row && row.ai }]}>{row.eyebrow}</p>
              <h2>{row.h}</h2>
              <p class="lead">{row.p}</p>
              <ul class="checks">{row.pts.map((p) => <li><Icon name="check" />{p}</li>)}</ul>
              <a class="link-arrow" href={fPath(lang, row.k)}>{f(row.k).nav}: {u.learnMore.toLowerCase()}<Icon name="arrow-right" /></a>
              <div class="story-inline"><Mock kind={row.mock} lang={lang} /></div>
            </article>
          ))}
        </div>
        <div class="story-stage" aria-hidden="true">
          <div class="story-sticky">
            <div class="story-dots">{rows.map((row) => <span data-dot class:list={{ ai: 'ai' in row && row.ai }}>{row.eyebrow}</span>)}</div>
            <div class="story-vis-wrap">
              {rows.map((row) => <div class="story-vis" data-vis><Mock kind={row.mock} lang={lang} /></div>)}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec fog">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow rv">{T('Ve daha fazlası', 'And more')}</p>
        <h2 class="rv-h">{T('Şablondan rapora, panelden API’ye.', 'From templates to reports, from the panel to the API.')}</h2>
      </div>
      <div class="bento">
        <a class="card b-tpl rv" href={fPath(lang, ft.key)}>
          <span class="ibox"><Icon name={ft.icon} /></span>
          <h3>{ft.nav}</h3>
          <p>{ft.summary}</p>
          <span class="more">{u.learnMore}<Icon name="arrow-right" /></span>
          <div class="b-vis"><Mock kind="templates" lang={lang} /></div>
        </a>
        <a class="card b-an rv" href={fPath(lang, fa.key)}>
          <span class="ibox"><Icon name={fa.icon} /></span>
          <h3>{fa.nav}</h3>
          <p>{fa.summary}</p>
          <span class="more">{u.learnMore}<Icon name="arrow-right" /></span>
          <div class="mini-bars" aria-hidden="true">{[94, 71, 38, 62, 84, 46, 76].map((h) => <i style={`--h:${h}%`}></i>)}</div>
        </a>
        <a class="card b-api dark rv" href={fPath(lang, fapi.key)}>
          <span class="ibox"><Icon name={fapi.icon} /></span>
          <h3>{fapi.nav}</h3>
          <p>{fapi.summary}</p>
          <pre aria-hidden="true"><code><span class="k">POST</span> /api/v1/messages{'\n'}<span class="c">Idempotency-Key:</span> siparis-48213{'\n'}<span class="c">→</span> <span class="ok">202 Accepted</span></code></pre>
          <span class="more">{u.learnMore}<Icon name="arrow-right" /></span>
        </a>
        <div class="card b-sm rv"><span class="ibox"><Icon name="globe" /></span><h3>{T('Kurumsal’da kendi adresiniz', 'Your own address on Enterprise')}</h3><p>{T('Panel app.messora.tech’te; Kurumsal pakette firma.messora.tech ya da kendi alan adınız.', 'The panel is at app.messora.tech; on Enterprise, company.messora.tech or your own domain.')}</p></div>
        <div class="card b-sm rv"><span class="ibox"><Icon name="users" /></span><h3>{T('Roller ve iki adımlı doğrulama', 'Roles and two-factor sign-in')}</h3><p>{T('Owner, Admin, Manager ve Agent rolleri; her işlem denetim kaydında.', 'Owner, Admin, Manager and Agent roles, with every action in the audit log.')}</p></div>
        <div class="card b-sm rv"><span class="ibox"><Icon name="download" /></span><h3>{T('Dışa aktarım', 'Exports')}</h3><p>{T('Listeler CSV/Excel, kampanya raporları PDF olarak her pakette.', 'Lists as CSV/Excel and campaign reports as PDF, in every plan.')}</p></div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow rv">{T('Sektörünüze göre', 'For your industry')}</p>
        <h2 class="rv-h">{T('Aynı WhatsApp, farklı işler.', 'Same WhatsApp, different jobs.')}</h2>
        <p class="lead rv">{T('Kargo bildiriminden randevu hatırlatmasına, her sektör için gerçekçi akışlar ve onaya uygun şablon örnekleri.', 'From shipping updates to appointment reminders: realistic flows and approval-ready template examples for each industry.')}</p>
      </div>
      <div class="grid g4 sectors">
        {solutions(lang).map((s) => (
          <a class="card rv" href={sPath(lang, s.key)}>
            <span class="ibox"><Icon name={s.icon} /></span>
            <h3>{s.nav}</h3>
            <p>{s.summary}</p>
          </a>
        ))}
        <a class="card rv all" href={r(lang, 'solutions')}><h3>{u.nav.allSolutions}</h3><span class="more">{u.learnMore}<Icon name="arrow-right" /></span></a>
      </div>
    </div>
  </section>

  <section class="sec dark lit">
    <div class="wrap split">
      <div class="rv">
        <p class="eyebrow ai">{T('Güvenlik ve veri', 'Security and data')}</p>
        <h2>{T('Verileriniz AB’de, firmanıza ayrık ve şifreli.', 'Your data in the EU, isolated and encrypted.')}</h2>
        <p class="lead">{T('Messora AWS’nin Frankfurt bölgesinde çalışır. Her kayıt firmanızla etiketlenir ve veritabanı başka firmanın satırını göstermez. Meta token’ları ve API anahtarları şifreli saklanır.', 'Messora runs in AWS’s Frankfurt region. Every record carries your company, and the database won’t show another company’s rows. Meta tokens and API keys are stored encrypted.')}</p>
        <ul class="checks">
          <li><Icon name="check" />{T('İki adımlı doğrulama, roller ve denetim kaydı', 'Two-factor sign-in, roles and an audit log')}</li>
          <li><Icon name="check" />{T('Her gece şifreli yedek', 'Encrypted backups every night')}</li>
          <li><Icon name="check" />{T('KVKK ve GDPR’a uygun veri işleme sözleşmesi', 'A data processing agreement for KVKK and GDPR')}</li>
        </ul>
        <a class="more" href={r(lang, 'security')}>{u.nav.security}: {u.learnMore.toLowerCase()}<Icon name="arrow-right" /></a>
      </div>
      <div class="rv"><Mock kind="security" lang={lang} /></div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow rv">{T('Başlamak', 'Getting started')}</p>
        <h2 class="rv-h">{T('Bir öğleden sonra kurulur.', 'Set up in an afternoon.')}</h2>
        <p class="lead rv">{T('Meta’nın işletme doğrulaması ve şablon onayı birkaç gün sürebilir; Messora’daki kurulumunuz ise kısa.', 'Meta’s business verification and template approval can take a few days; your setup in Messora is short.')}</p>
      </div>
      <ol class="steps">
        <li class="rv"><h3>{T('Hesabınızı açın', 'Create your account')}</h3><p>{T('app.messora.tech’te kaydolun, 14 gün ücretsiz deneyin; kart gerekmez.', 'Sign up at app.messora.tech and try it free for 14 days, no card needed.')}</p></li>
        <li class="rv"><h3>{T('Meta hesabınızı bağlayın', 'Connect your Meta account')}</h3><p>{T('Kendi Meta uygulamanızla, sihirbazın gösterdiği adımlarla. Tek tıkla bağlantı (Embedded Signup) yakında.', 'With your own Meta app, following the wizard. One-click connection (Embedded Signup) is coming soon.')}</p></li>
        <li class="rv"><h3>{T('Şablonlarınızı onaya gönderin', 'Submit your templates')}</h3><p>{T('Şablon oluşturucuda hazırlayın, Meta’ya gönderin; onay durumu panelde güncellenir.', 'Build them in the template builder and send them to Meta; the approval status updates in the panel.')}</p></li>
        <li class="rv"><h3>{T('Ekibinizi davet edin', 'Invite your team')}</h3><p>{T('Rolleri verin, hazır otomasyonları açın, ilk kampanyanızın maliyetini görün.', 'Give out roles, switch on presets and see what your first campaign will cost.')}</p></li>
      </ol>
    </div>
  </section>

  <section class="sec fog">
    <div class="wrap">
      <div class="sec-head center">
        <p class="eyebrow rv">{u.nav.pricing}</p>
        <h2 class="rv-h">{T('Taahhüt yok. Meta ücreti ayrı ve görünür.', 'No lock-in. Meta fees separate and visible.')}</h2>
        <p class="lead rv">{T(`Fiyatlar TL + KDV, aylık. ${ph.yearly}`, `Prices in TL + VAT per month. ${ph.yearly}`)}</p>
      </div>
      <Fragment set:html={P.slot(`teaser:${lang}`, P.teaser(plans, lang))} />
      <p class="center" style="margin-top:36px"><a class="btn btn-ghost" href={r(lang, 'pricing')}>{T('Paketleri karşılaştırın', 'Compare plans')}<Icon name="arrow-right" /></a></p>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="sec">
      <div class="wrap">
        <div class="sec-head row-head">
          <div>
            <p class="eyebrow rv">{u.nav.resources}</p>
            <h2 class="rv-h">{T('WhatsApp Business API’yi doğru kullanmak için.', 'Using the WhatsApp Business API the right way.')}</h2>
          </div>
          <a class="link-arrow rv" href={r(lang, 'resources')}>{u.nav.blog}<Icon name="arrow-right" /></a>
        </div>
        <div class="grid g3 posts">
          {posts.map((p, i) => (
            <a class="card post rv" href={blogBase + p.data.slug}>
              <span class:list={['post-art', `pa${i}`]} aria-hidden="true"><Icon name={(['chart', 'shield', 'message'] as const)[i % 3]} size={26} /></span>
              <p class="small muted">{p.data.tags[0]} · {readingMinutes(p.data.words)} {u.minRead}</p>
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
              <span class="more">{u.readMore}<Icon name="arrow-right" /></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="sec fog">
    <div class="wrap faq-wrap">
      <div class="sec-head">
        <p class="eyebrow rv">{u.nav.faq}</p>
        <h2 class="rv-h">{T('Aklınıza takılanlar', 'Questions you may have')}</h2>
        <p class="rv" style="margin-top:20px"><a class="link-arrow" href={r(lang, 'faq')}>{T('Tüm sorular', 'All questions')}<Icon name="arrow-right" /></a></p>
      </div>
      <FaqList items={faqs} />
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>

<style>
  .hero-home { padding: calc(var(--hdr-h) + clamp(56px, 9vw, 120px)) 0 0; overflow: visible; z-index: 2; }
  .hh-copy { text-align: center; display: flex; flex-direction: column; align-items: center; }
  .hh-copy .pill-eyebrow { margin-bottom: 28px; }
  .hero-home h1 { font-size: var(--fs-display); letter-spacing: -.045em; line-height: 1; color: #F4F6FB; max-width: 1000px; }
  .hero-home .lead { margin-top: 26px; max-width: 700px; }
  .hero-home .actions { justify-content: center; margin-top: 36px; }
  .hero-home .hero-points { justify-content: center; }
