---
import type { Faq } from '../data/types';
import Icon from './Icon.astro';
interface Props { items: Faq[]; open?: number }
const { items, open = -1 } = Astro.props;
---
<div class="faq">
  {items.map((f, i) => (
    <details open={i === open}>
      <summary>{f.q}<Icon name="plus" /></summary>
      <div class="a">{f.a.split(/\n\n+/).map((p) => <p set:html={p.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/\[([^\]]+)\]\((\/[^)\s]*|https:\/\/[^)\s]+)\)/g, '<a href="$2">$1</a>')} />)}</div>
    </details>
  ))}
</div>
