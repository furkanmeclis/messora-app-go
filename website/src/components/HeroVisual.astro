---
// Home hero product visual: a layered mock of the Messora inbox built in
// HTML/CSS. Elements with data-at appear step by step (ui.ts); without JS or
// with reduced motion the final state is shown. Data shown is illustrative.
import type { Lang } from '../data/types';
import Icon from './Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = lang === 'tr';
const T = (a: string, b: string) => (tr ? a : b);
const list = [
  { n: 'Ayşe Yılmaz', i: 'AY', c: 'a', p: T('Adresi değiştirebilir miyim?', 'Can I change the address?'), t: '14:02', on: true },
  { n: 'Mert Kaya', i: 'MK', c: 'b', p: T('Teşekkürler, ulaştı.', 'Thanks, it arrived.'), t: '13:48', chip: ['ai', 'AI'] },
  { n: '+90 532 *** 41 07', i: '+', c: 'c', p: T('Fiyat listesi var mı?', 'Do you have a price list?'), t: '13:31', chip: ['soon', T('Atanmamış', 'Unassigned')] },
  { n: 'Deniz Ö.', i: 'DÖ', c: 'd', p: T('Yarın açık mısınız?', 'Are you open tomorrow?'), t: '12:57', chip: ['ai', 'AI'] },
  { n: 'Can Bilgin', i: 'CB', c: 'e', p: T('Kargo kodu gelmedi', 'No tracking code yet'), t: '12:10', chip: ['gray', 'Mert'] },
];
---
<div class="hv" data-hv>
  <div class="hv-stage" data-tilt>
    <div class="hv-win" role="img" aria-label={T('Messora gelen kutusundan örnek görünüm: AI bir soruyu yanıtlıyor, emin olmadığında konuşmayı ekipten Elif’e devrediyor.', 'Illustrative view of the Messora inbox: the AI answers a question and hands the conversation to Elif from the team when it isn’t sure.')}>
      <div class="hv-bar" aria-hidden="true"><i></i><i></i><i></i><span class="url"><Icon name="lock" size={11} />app.messora.tech/inbox</span></div>
      <div class="hv-app" aria-hidden="true">
        <div class="hv-rail">
          <span class="on"><Icon name="inbox" size={18} /><b>4</b></span>
          <span><Icon name="megaphone" size={18} /></span>
          <span class="ai"><Icon name="sparkle" size={18} /></span>
          <span><Icon name="flow" size={18} /></span>
          <span><Icon name="chart" size={18} /></span>
          <span><Icon name="users" size={18} /></span>
        </div>
        <div class="hv-list">
          <div class="hv-lh"><b>{T('Gelen kutusu', 'Inbox')}</b><span class="tabs"><em class="on">{T('Bana', 'Mine')} 4</em><em>{T('Atanmamış', 'Unassigned')} 2</em><em>AI 7</em></span></div>
          <ul>
            {list.map((x) => (
              <li class:list={{ on: x.on }}>
                <span class:list={['av', x.c]}>{x.i}</span>
                <span class="tx"><b>{x.n}</b><span>{x.p}</span></span>
                <span class="mt">
                  <time>{x.t}</time>
                  {x.on
                    ? <span class="sw"><em class="chip ai" data-at="0" data-until="5">AI</em><em class="chip gray" data-at="5">Elif</em></span>
                    : <em class:list={['chip', x.chip![0]]}>{x.chip![1]}</em>}
                </span>
              </li>
            ))}
          </ul>
        </div>
        <div class="hv-chat">
          <div class="hv-ch">
            <span class="av a">AY</span>
            <span class="who"><b>Ayşe Yılmaz</b><span>WhatsApp · +90 532 *** 41 07</span></span>
            <span class="win-pill"><svg viewBox="0 0 20 20" width="16" height="16"><circle cx="10" cy="10" r="7" /><circle class="arc" cx="10" cy="10" r="7" pathLength="100" /></svg>{T('Pencere 21 sa', 'Window 21 h')}</span>
            <span class="owner">{T('Sahibi', 'Owner')}: <span class="sw"><b data-at="0" data-until="5">{T('AI ajanı', 'AI agent')}</b><b data-at="5">Elif K.</b></span></span>
          </div>
          <div class="hv-msgs">
            <p class="m in" data-at="0">{T('Merhaba, 48213 numaralı siparişim ne zaman gelir?', 'Hi, when will order 48213 arrive?')}<time>14:00</time></p>
            <div class="slot">
              <p class="typing" data-at="1" data-until="2"><span><i></i><i></i><i></i></span>{T('AI yazıyor', 'AI is typing')}</p>
              <p class="m ai" data-at="2"><small><Icon name="sparkle" size={11} />{T('AI cevapladı', 'AI replied')}</small>{T('Siparişiniz dün kargoya verildi, yarın teslim edilmesi bekleniyor.', 'Your order shipped yesterday and should arrive tomorrow.')}<time>14:00</time></p>
            </div>
            <p class="m in" data-at="3">{T('Adresi değiştirebilir miyim?', 'Can I change the address?')}<time>14:02</time></p>
            <p class="sys" data-at="4"><Icon name="handoff" size={13} />{T('AI emin olmadı, Elif’e devretti', 'AI wasn’t sure and handed over to Elif')}</p>
            <p class="nt" data-at="6"><Icon name="note" size={13} /><span><b>Elif:</b> {T('Kargo firmasını arıyorum, 10 dk.', 'Calling the courier, 10 min.')}</span><em>{T('Ekibe özel', 'Internal')}</em></p>
          </div>
          <div class="hv-cmp"><span>{T('Yanıt yazın…', 'Write a reply…')}</span><em>{T('Not ekle', 'Add note')}</em><b><Icon name="send" size={15} /></b></div>
        </div>
        <div class="hv-side">
          <div class="pf"><span class="av a lg">AY</span><b>Ayşe Yılmaz</b><span>İzmir</span></div>
          <dl>
            <div><dt>{T('Pazarlama izni', 'Marketing consent')}</dt><dd class="ok"><Icon name="check-circle" size={13} />{T('Var · web formu', 'Yes · web form')}</dd></div>
            <div><dt>{T('Etiketler', 'Tags')}</dt><dd><em class="chip gray">{T('sadık-müşteri', 'loyal')}</em> <em class="chip gray">izmir</em></dd></div>
            <div class="cap" data-at="2"><dt><Icon name="sparkle" size={12} />{T('AI’ın yakaladığı', 'Captured by AI')}</dt><dd><em>{T('Ad: Ayşe', 'Name: Ayşe')}</em><em>{T('Şehir: İzmir', 'City: İzmir')}</em></dd></div>
            <div><dt>{T('24 saat penceresi', '24-hour window')}</dt><dd><span class="bar"><i></i></span></dd></div>
          </dl>
        </div>
      </div>
    </div>

    <div class="hv-float hv-camp" data-depth="1.4" aria-hidden="true">
      <div class="fh"><span class="chip">{T('Gönderim öncesi', 'Before sending')}</span><b>{T('Kasım indirimi', 'November sale')}</b></div>
      <dl>
        <div><dt>{T('Kitle', 'Audience')}</dt><dd>1.200</dd></div>
        <div class="warn"><dt>{T('İzin yok, gönderilmeyecek', 'Opted out, skipped')}</dt><dd>85</dd></div>
        <div><dt>{T('Tahmini Meta ücreti', 'Est. Meta fee')}</dt><dd>12,15 $</dd></div>
      </dl>
      <span class="lane"><i></i></span>
    </div>

    <div class="hv-float hv-ai" data-depth="2.4" aria-hidden="true">
      <span class="dot"></span>
      <span><b>{T('Satış asistanı', 'Sales assistant')}</b><small>{T('Emin değilse ekibe devreder', 'Hands over when unsure')}</small></span>
    </div>
  </div>
</div>

<style>
  .hv { position: relative; z-index: 2; max-width: 1160px; margin: 0 auto; font-size: 13px; line-height: 1.45; color: var(--on-dark); }
  .hv::before { content: ""; position: absolute; left: -6%; right: -6%; top: -4%; bottom: -14%; z-index: -1; border-radius: 50%; background: radial-gradient(closest-side, rgba(91,107,240,.42), rgba(45,212,167,.08) 65%, transparent); pointer-events: none; }
  .hv-stage { position: relative; transform: perspective(1800px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)); transition: transform .8s var(--ease-out); transform-style: preserve-3d; }
  :global(.js) .hv-stage { animation: hvIn 1.4s var(--ease-out) .25s backwards; }
  @keyframes hvIn { from { opacity: 0; transform: perspective(1800px) rotateX(14deg) translateY(40px) scale(.96); } }

  .hv-win { position: relative; border-radius: 18px; overflow: hidden; background: linear-gradient(180deg, #111A2E, #0C1424); box-shadow: 0 0 0 1px rgba(255,255,255,.09), 0 1px 0 rgba(255,255,255,.12) inset, 0 50px 120px -30px rgba(0,0,0,.75), 0 30px 60px -40px rgba(59,76,202,.6); }
  .hv-win::after { content: ''; position: absolute; inset: 0; pointer-events: none; border-radius: inherit; background: linear-gradient(115deg, rgba(255,255,255,.06), transparent 35%); }
  .hv-bar { display: flex; align-items: center; gap: 6px; height: 38px; padding: 0 14px; border-bottom: 1px solid rgba(255,255,255,.07); background: rgba(255,255,255,.02); }
  .hv-bar i { width: 10px; height: 10px; border-radius: 50%; background: #2A3550; }
  .hv-bar .url { display: inline-flex; align-items: center; gap: 6px; margin: 0 auto; font-size: 11.5px; color: #8F9AB8; background: rgba(255,255,255,.05); padding: 4px 14px; border-radius: 7px; }
  .hv-app { display: grid; grid-template-columns: 58px 280px minmax(0, 1fr) 230px; height: 500px; }

  .hv-rail { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 14px 0; border-right: 1px solid rgba(255,255,255,.07); background: rgba(0,0,0,.12); }
  .hv-rail span { position: relative; width: 38px; height: 38px; border-radius: 11px; display: grid; place-items: center; color: #7F8AA8; }
  .hv-rail span.on { background: rgba(91,107,240,.22); color: #fff; }
  .hv-rail span.ai { color: var(--mint); }
  .hv-rail b { position: absolute; top: 3px; right: 2px; min-width: 15px; height: 15px; padding: 0 4px; border-radius: 8px; background: var(--coral); color: var(--night); font: 700 9.5px/15px var(--f-body); text-align: center; }

  .hv-list { border-right: 1px solid rgba(255,255,255,.07); padding: 14px 10px; overflow: hidden; }
  .hv-lh { display: flex; flex-direction: column; gap: 10px; padding: 0 6px 12px; }
  .hv-lh b { font: 700 15px/1.2 var(--f-head); color: #F4F6FB; letter-spacing: -.01em; }
  .tabs { display: flex; gap: 4px; }
  .tabs em { font-style: normal; font-size: 11px; padding: 4px 8px; border-radius: 7px; color: #8F9AB8; background: rgba(255,255,255,.04); }
  .tabs em.on { color: #fff; background: rgba(91,107,240,.28); }
  .hv-list ul { list-style: none; display: grid; gap: 2px; }
  .hv-list li { display: grid; grid-template-columns: 32px minmax(0, 1fr) auto; gap: 10px; align-items: center; padding: 9px 8px; border-radius: 11px; }
  .hv-list li.on { background: linear-gradient(90deg, rgba(59,76,202,.32), rgba(59,76,202,.14)); box-shadow: 0 0 0 1px rgba(91,107,240,.25) inset; }
  .tx { display: grid; min-width: 0; }
  .tx b { font-weight: 600; font-size: 12.5px; color: #F4F6FB; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tx span { color: #8F9AB8; font-size: 11.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mt { display: grid; justify-items: end; gap: 4px; }
  .mt time { font-size: 10.5px; color: #6F7A98; }
  .av { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; font: 700 11px/1 var(--f-body); color: #fff; flex: none; }
  .av.a { background: linear-gradient(135deg, #5B6BF0, #3B4CCA); }
  .av.b { background: linear-gradient(135deg, #3F7A8C, #24485A); }
  .av.c { background: #24304B; color: #A3AECA; }
  .av.d { background: linear-gradient(135deg, #8C6A3F, #5A4024); }
  .av.e { background: linear-gradient(135deg, #6A4C8C, #3F2A5A); }
  .av.lg { width: 52px; height: 52px; font-size: 15px; }
  .chip { display: inline-flex; padding: 2px 8px; border-radius: 999px; font: 600 10.5px/1.4 var(--f-body); font-style: normal; background: rgba(91,107,240,.25); color: #D4D9FF; white-space: nowrap; }
  .chip.ai { background: var(--mint); color: var(--night); }
  .chip.gray { background: rgba(255,255,255,.1); color: #D7DCEB; }
  .chip.soon { background: rgba(255,122,89,.18); color: #FFC2B0; }
  .sw { display: inline-grid; }
  .sw > * { grid-area: 1 / 1; justify-self: end; }

  .hv-chat { display: flex; flex-direction: column; min-width: 0; background: radial-gradient(80% 50% at 50% 0%, rgba(91,107,240,.08), transparent); }
  .hv-ch { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-bottom: 1px solid rgba(255,255,255,.07); }
  .who { display: grid; min-width: 0; margin-right: auto; }
  .who b { font-size: 13.5px; color: #F4F6FB; }
  .who span { font-size: 11px; color: #8F9AB8; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .win-pill { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; color: #A3AECA; padding: 4px 9px 4px 6px; border-radius: 999px; background: rgba(255,255,255,.05); white-space: nowrap; }
  .win-pill svg { transform: rotate(-90deg); fill: none; stroke-width: 2.4; }
  .win-pill circle { stroke: rgba(255,255,255,.12); }
  .win-pill .arc { stroke: var(--mint); stroke-dasharray: 88 100; stroke-linecap: round; }
  .owner { font-size: 11px; color: #8F9AB8; white-space: nowrap; }
  .owner .sw > * { justify-self: start; }
  .owner b { color: #F4F6FB; font-weight: 600; }
  .hv-msgs { flex: 1; display: flex; flex-direction: column; gap: 9px; padding: 16px; overflow: hidden; }
  .m { position: relative; max-width: 78%; padding: 9px 12px 18px; border-radius: 15px; margin: 0; font-size: 12.5px; }
  .m time { position: absolute; right: 10px; bottom: 4px; font-size: 9.5px; color: rgba(255,255,255,.4); }
  .m.in { align-self: flex-start; background: #1C2740; border-bottom-left-radius: 5px; }
  .m.ai { align-self: flex-end; background: linear-gradient(135deg, #2F3DA8, #26338C); border-bottom-right-radius: 5px; box-shadow: 0 8px 24px -10px rgba(59,76,202,.8); }
  .m small { display: flex; gap: 4px; align-items: center; font-size: 10.5px; font-weight: 700; color: var(--mint); margin-bottom: 3px; }
  .slot { display: grid; }
  .slot > * { grid-area: 1 / 1; }
  .typing { align-self: end; justify-self: end; display: inline-flex; align-items: center; gap: 8px; margin: 0; padding: 9px 12px; border-radius: 15px; border-bottom-right-radius: 5px; background: rgba(59,76,202,.3); color: #C8CEFF; font-size: 11.5px; }
  .typing span { display: inline-flex; gap: 3px; }
  .typing i { width: 5px; height: 5px; border-radius: 50%; background: var(--mint); animation: blink 1.1s infinite ease-in-out; }
  .typing i:nth-child(2) { animation-delay: .15s; }
  .typing i:nth-child(3) { animation-delay: .3s; }
  @keyframes blink { 0%, 80%, 100% { opacity: .25; transform: translateY(0); } 40% { opacity: 1; transform: translateY(-2px); } }
  .sys { align-self: center; display: inline-flex; gap: 6px; align-items: center; background: rgba(255,122,89,.13); color: #FFC2B0; font-size: 11px; padding: 5px 12px; border-radius: 999px; margin: 2px 0; box-shadow: 0 0 0 1px rgba(255,122,89,.18) inset; }
  .nt { align-self: stretch; display: flex; gap: 8px; align-items: center; background: rgba(255,214,102,.09); color: #FFE08A; font-size: 11.5px; padding: 8px 11px; border-radius: 11px; margin: 0; box-shadow: 0 0 0 1px rgba(255,214,102,.14) inset; }
  .nt span { flex: 1; }
  .nt em { font-style: normal; font-size: 10px; opacity: .75; }
  .hv-cmp { display: flex; align-items: center; gap: 10px; margin: 0 14px 14px; padding: 8px 8px 8px 14px; border: 1px solid rgba(255,255,255,.1); border-radius: 13px; color: #6F7A98; background: rgba(0,0,0,.15); }
  .hv-cmp span { flex: 1; }
  .hv-cmp em { font-style: normal; color: #AEB7F5; font-size: 11.5px; }
  .hv-cmp b { width: 30px; height: 30px; border-radius: 9px; display: grid; place-items: center; background: var(--indigo); color: #fff; }

  .hv-side { border-left: 1px solid rgba(255,255,255,.07); padding: 18px 16px; background: rgba(0,0,0,.08); }
  .pf { display: grid; justify-items: center; gap: 4px; text-align: center; padding-bottom: 14px; border-bottom: 1px solid rgba(255,255,255,.07); }
  .pf b { color: #F4F6FB; font-size: 13.5px; margin-top: 6px; }
  .pf span:last-child { color: #8F9AB8; font-size: 11.5px; }
  .hv-side dl { margin: 0; display: grid; gap: 14px; padding-top: 14px; }
  .hv-side dt { display: flex; gap: 5px; align-items: center; font-size: 10.5px; letter-spacing: .06em; text-transform: uppercase; color: #6F7A98; margin-bottom: 5px; }
  .hv-side dd { margin: 0; display: flex; flex-wrap: wrap; gap: 4px; align-items: center; font-size: 12px; }
  .hv-side dd.ok { color: var(--mint); font-weight: 600; gap: 5px; }
  .cap { padding: 10px; border-radius: 11px; background: rgba(45,212,167,.07); box-shadow: 0 0 0 1px rgba(45,212,167,.28) inset; }
  .cap dt { color: var(--mint); }
  .cap em { font-style: normal; padding: 2px 7px; border-radius: 6px; background: rgba(255,255,255,.07); font-size: 11.5px; }
  .bar { display: block; width: 100%; height: 6px; border-radius: 3px; background: rgba(255,255,255,.08); overflow: hidden; }
  .bar i { display: block; width: 88%; height: 100%; border-radius: 3px; background: linear-gradient(90deg, var(--mint), #5FE0BD); }

  .hv-float { position: absolute; transform: translate3d(0, var(--py, 0px), 0); transition: transform .2s linear; }
  :global(.js) .hv-float { animation: hvFloatIn 1.2s var(--ease-out) backwards; }
  @keyframes hvFloatIn { from { opacity: 0; translate: 0 24px; } }
  .hv-camp { left: -48px; bottom: 56px; width: 270px; padding: 14px 16px; border-radius: 18px; background: rgba(255,255,255,.97); color: var(--ink); box-shadow: 0 1px 0 #fff inset, 0 30px 70px -20px rgba(3,7,18,.6), 0 0 0 1px rgba(11,18,32,.06); animation-delay: .9s !important; }
  .fh { display: flex; flex-wrap: wrap; gap: 6px 8px; align-items: center; margin-bottom: 8px; }
  .fh .chip { background: var(--indigo-soft); color: var(--indigo-d); }
  .fh b { font: 700 13.5px/1.2 var(--f-head); }
  .hv-camp dl { margin: 0; }
  .hv-camp dl div { display: flex; justify-content: space-between; gap: 10px; padding: 6px 0; border-bottom: 1px solid var(--line); font-size: 12px; }
  .hv-camp dt { color: var(--muted); }
  .hv-camp dd { margin: 0; font: 700 13px/1.2 var(--f-head); font-variant-numeric: tabular-nums; }
  .hv-camp .warn dd { color: #C2410C; }
  .lane { display: block; height: 6px; margin-top: 10px; border-radius: 3px; background: var(--fog-2); overflow: hidden; }
  .lane i { display: block; height: 100%; width: 62%; border-radius: 3px; background: linear-gradient(90deg, var(--indigo), var(--indigo-l)); }
  :global(.js) .hv[data-play] .lane i { animation: lane 6s var(--ease-io) infinite alternate; }
  @keyframes lane { from { width: 18%; } to { width: 78%; } }
  .hv-ai { right: 26%; top: -26px; display: flex; gap: 10px; align-items: center; padding: 11px 16px 11px 12px; border-radius: 16px; background: rgba(13,20,36,.82); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); box-shadow: 0 0 0 1px rgba(45,212,167,.35), 0 24px 50px -18px rgba(0,0,0,.7), 0 0 40px -10px rgba(45,212,167,.35); animation-delay: 1.15s !important; }
  .hv-ai b { display: block; color: #F4F6FB; font-size: 12.5px; }
  .hv-ai small { display: block; color: var(--muted-d); font-size: 11px; }
  .dot { position: relative; width: 30px; height: 30px; border-radius: 10px; background: var(--mint); flex: none; }
  .dot::before { content: ''; position: absolute; inset: 9px; border-radius: 50%; background: var(--night); }
  .dot::after { content: ''; position: absolute; inset: 0; border-radius: inherit; box-shadow: 0 0 0 0 rgba(45,212,167,.6); animation: aiPulse 2.2s var(--ease-out) infinite; }
  @keyframes aiPulse { 0% { box-shadow: 0 0 0 0 rgba(45,212,167,.55); } 70%, 100% { box-shadow: 0 0 0 12px rgba(45,212,167,0); } }

  /* Step-by-step playback (ui.ts sets data-play and toggles .on) */
  :global(.hv:not([data-play])) [data-until] { visibility: hidden; }
  :global(.hv[data-play]) [data-at] { opacity: 0; transform: translateY(8px) scale(.97); transition: opacity .5s var(--ease-out), transform .6s var(--ease-out); }
  :global(.hv[data-play]) .sw [data-at], :global(.hv[data-play]) .cap[data-at] { transform: none; }
  :global(.hv[data-play]) [data-at].on { opacity: 1; transform: none; }
  :global(.hv[data-play]) .m.ai[data-at] { transform-origin: bottom right; }
  :global(.hv[data-play]) .m.in[data-at] { transform-origin: bottom left; }

  @media (max-width: 1180px) { .hv-app { grid-template-columns: 58px 260px minmax(0, 1fr); } .hv-side { display: none; } .hv-camp { left: -12px; } .hv-ai { right: -10px; } }
  @media (max-width: 820px) {
    .hv-app { grid-template-columns: 52px minmax(0, 1fr); height: 440px; }
    .hv-list { display: none; }
    .hv-camp { left: 12px; bottom: -40px; width: 240px; }
    .hv-ai { right: 10px; top: -22px; }
  }
  @media (max-width: 560px) {
    .hv { font-size: 12px; }
    .hv-app { grid-template-columns: minmax(0, 1fr); height: 420px; }
    .hv-rail, .owner, .win-pill { display: none; }
    .hv-camp { left: 8px; bottom: -88px; width: 220px; padding: 12px 14px; }
    .hv-ai { right: 6px; top: -26px; padding: 9px 12px 9px 10px; }
    .hv-ai small { display: none; }
    .m { max-width: 88%; }
  }
</style>
