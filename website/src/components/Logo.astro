---
// Messora logo — concept A "Balon M" (brand canvas, BrandLogo).
interface Props { dark?: boolean; size?: number; wordmark?: boolean; class?: string }
const { dark = false, size = 30, wordmark = true, class: cls } = Astro.props;
const fill = dark ? '#5B6BF0' : '#3B4CCA';
---
<span class:list={['logo', cls]}>
  <svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false"><path d="M14 6h36a10 10 0 0 1 10 10v24a10 10 0 0 1-10 10H26l-12 9v-9a10 10 0 0 1-10-10V16A10 10 0 0 1 14 6z" fill={fill}/><path d="M19 39V24a5 5 0 0 1 10 0v15M29 24a5 5 0 0 1 10 0v15M39 24a5 5 0 0 1 6-4.9" fill="none" stroke="#FFFFFF" stroke-width="4.5" stroke-linecap="round"/><circle cx="47" cy="17" r="4" fill="#2DD4A7"/></svg>
  {wordmark && <span class="logo-word">messora</span>}
</span>
