---
import type { Lang } from '../data/types';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { t } from '../i18n/ui';
import { features, solutions, fPath, sPath, r } from '../lib/site';
import { appUrls } from '../data/routes';
interface Props { lang: Lang; path: string; altPath?: string | null; minimal?: boolean }
const { lang, path, altPath, minimal = false } = Astro.props;
const u = t(lang);
const fs = features(lang);
const ss = solutions(lang);
const cur = (p: string) => (path === p || path.startsWith(p + '/') ? 'page' : undefined);
const langHref = altPath ?? (lang === 'tr' ? '/en' : '/');
---
<header class="hdr">
  <div class="wrap hdr-in">
    <a href={r(lang, 'home')} class="logo" aria-label="Messora"><Logo dark size={30} /></a>
    {!minimal && (
      <nav aria-label={lang === 'tr' ? 'Ana menü' : 'Main menu'} style="flex:1">
        <ul class="nav">
          <li>
            <button class="nav-a" type="button" aria-expanded="false" aria-controls="mega-f" data-mega>{u.nav.features}<Icon name="chevron-down" /></button>
            <div class="mega" id="mega-f">
              {fs.map((f) => (
                <a href={fPath(lang, f.key)}><span class:list={['mi', { ai: f.key === 'ai' }]}><Icon name={f.icon} /></span><span><strong>{f.nav}</strong><span class="d">{f.summary.split('. ')[0].replace(/\.$/, '')}</span></span></a>
              ))}
              <a class="all" href={r(lang, 'features')}>{u.nav.allFeatures}<Icon name="arrow-right" /></a>
            </div>
          </li>
          <li>
            <button class="nav-a" type="button" aria-expanded="false" aria-controls="mega-s" data-mega>{u.nav.solutions}<Icon name="chevron-down" /></button>
            <div class="mega" id="mega-s">
              {ss.map((s) => (
                <a href={sPath(lang, s.key)}><span class="mi"><Icon name={s.icon} /></span><span><strong>{s.nav}</strong><span class="d">{s.summary.split('. ')[0].replace(/\.$/, '')}</span></span></a>
              ))}
              <a class="all" href={r(lang, 'solutions')}>{u.nav.allSolutions}<Icon name="arrow-right" /></a>
            </div>
          </li>
          <li><a class="nav-a" href={r(lang, 'pricing')} aria-current={cur(r(lang, 'pricing'))}>{u.nav.pricing}</a></li>
          <li><a class="nav-a" href={r(lang, 'security')} aria-current={cur(r(lang, 'security'))}>{u.nav.security}</a></li>
          <li><a class="nav-a" href={r(lang, 'resources')} aria-current={cur(r(lang, 'resources'))}>{u.nav.resources}</a></li>
        </ul>
      </nav>
    )}
    <div class="hdr-r">
      {!minimal && <a class="lang" href={langHref} hreflang={lang === 'tr' ? 'en' : 'tr'} lang={lang === 'tr' ? 'en' : 'tr'} aria-label={u.switchLangLabel}>{lang === 'tr' ? 'EN' : 'TR'}</a>}
      <a class="login" href={appUrls.login}>{u.login}</a>
      <a class="btn btn-sm" href={appUrls.signup} data-signup>{u.trial}</a>
      {!minimal && <button class="burger" type="button" aria-expanded="false" aria-controls="mnav" aria-label={u.menu} data-burger><Icon name="menu" /></button>}
    </div>
  </div>
  {!minimal && (
    <div class="mnav dark" id="mnav">
      <details><summary>{u.nav.features}<Icon name="chevron-down" /></summary>
        {fs.map((f) => <a href={fPath(lang, f.key)}>{f.nav}</a>)}
        <a href={r(lang, 'features')}>{u.nav.allFeatures}</a>
      </details>
      <details><summary>{u.nav.solutions}<Icon name="chevron-down" /></summary>
        {ss.map((s) => <a href={sPath(lang, s.key)}>{s.nav}</a>)}
        <a href={r(lang, 'solutions')}>{u.nav.allSolutions}</a>
      </details>
      <a href={r(lang, 'pricing')}>{u.nav.pricing}</a>
      <a href={r(lang, 'security')}>{u.nav.security}</a>
      <a href={r(lang, 'resources')}>{u.nav.resources}</a>
      <a href={langHref} hreflang={lang === 'tr' ? 'en' : 'tr'}>{u.switchLang}</a>
      <div class="actions">
        <a class="btn" href={appUrls.signup} data-signup>{u.trialLong}</a>
        <a class="btn btn-ghost" href={appUrls.login}>{u.login}</a>
      </div>
    </div>
  )}
</header>
