# Messora (multi-tenant) on Dokploy: the Environment of the Compose
# application whose Compose path is docker-compose.dokploy.yml. Dokploy
# writes it to .env next to the compose file. Replace every <…>; never
# commit the filled-in copy. Walkthrough: docs/INSTALL.md, staging on AWS:
# docs/STAGING_AWS.md.

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=info
LOG_FORMAT=json
# Tag of the images Dokploy builds from the repository (any label).
MESSORA_VERSION=staging

# ── Addresses ────────────────────────────────────────────────────────────────
# Companies at <slug>.messora.tech, admin panel at admin.messora.tech,
# sign-up at app.messora.tech, webhooks at hooks.messora.tech.
TENANT_BASE_DOMAIN=messora.tech
PUBLIC_APP_URL=https://app.messora.tech
HOOKS_PUBLIC_URL=https://hooks.messora.tech

# ── Edge (Traefik of Dokploy terminates TLS; Caddy runs plain HTTP) ─────────
EDGE_MODE=proxy
PROXY_NETWORK=dokploy-network
# Unique per installation on this Traefik (router, service and alias names).
PROXY_ROUTER=messora
PROXY_ENTRYPOINT=websecure
PROXY_HTTP_ENTRYPOINT=web
# DNS-01 resolver for the *.messora.tech wildcard (Traefik static config).
PROXY_DNS_CERTRESOLVER=letsencrypt-dns
# The proxy network's subnet; only Traefik's X-Forwarded-* are believed:
#   docker network inspect dokploy-network -f '{{range .IPAM.Config}}{{.Subnet}} {{end}}'
TRUSTED_PROXIES=<dokploy-network subnet, e.g. 10.0.1.0/24>

# ── Secrets ──────────────────────────────────────────────────────────────────
# Empty values are generated on first start into the messora-secrets volume.
# Setting them here keeps a second copy in Dokploy; keep a third offline
# (password manager). APP_ENCRYPTION_KEY decrypts every stored credential:
# losing it loses them. Constraints: ≥ 16 characters (BFF ≥ 32), no
# whitespace, quotes or backslashes.
#   openssl rand -base64 32                               # APP_ENCRYPTION_KEY
#   openssl rand -base64 36 | tr '+/' '-_' | tr -d '='    # every other value
APP_ENCRYPTION_KEY=<openssl rand -base64 32>
BFF_SHARED_SECRET=<random, ≥ 32 characters>
POSTGRES_PASSWORD=<random>
POSTGRES_APP_PASSWORD=<random>
POSTGRES_SYSTEM_PASSWORD=<random>
REDIS_PASSWORD=<random>
CENTRIFUGO_API_KEY=<random>
CENTRIFUGO_HMAC_SECRET=<random>

# ── File storage: S3 (credentials from the EC2 instance role) ───────────────
STORAGE_DRIVER=s3
S3_REGION=eu-central-1
S3_BUCKET_PRIVATE=messora-media-575500997783
S3_BUCKET_PUBLIC=messora-public-575500997783
# Set once CloudFront in front of the public bucket is live; until then
# public files are served by the app under /media/p/.
# PUBLIC_ASSET_BASE_URL=https://cdn.messora.tech

# ── E-mail: Resend over SMTP ─────────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_TLS=tls
SMTP_USERNAME=resend
SMTP_PASSWORD=<Resend API key>
SMTP_FROM=Messora <no-reply@messora.tech>

# ── Meta ─────────────────────────────────────────────────────────────────────
META_GRAPH_API_VERSION=v26.0
META_DRY_RUN=false

# ── Sizing for one 8 GB / 2 vCPU host shared with Dokploy (~1.5 GB) ─────────
MEM_POSTGRES=2g
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_WORK_MEM=8MB
MEM_REDIS=512m
MEM_CENTRIFUGO=256m
MEM_MESSORA_API=768m
MEM_MESSORA_WORKER=1g
MEM_MESSORA_SCHEDULER=128m
MEM_MESSORA_WEB=768m
MEM_CADDY=128m
MEM_BACKUP=256m
DB_MAX_CONNS=20
WORKER_CONCURRENCY=20

# ── Nightly database backup to S3 (deployments/backup) ──────────────────────
COMPOSE_PROFILES=backup
BACKUP_S3_BUCKET=messora-media-575500997783
BACKUP_S3_PREFIX=ops/backups/postgres
# UTC.
BACKUP_AT=02:30
BACKUP_RUN_ON_START=true
